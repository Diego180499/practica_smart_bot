# ============================================================
#  SmartBot Backend — Variables de Entorno
#  Copia este archivo como .env y ajusta los valores.
#  ¡NO subas este archivo a control de versiones!
# ============================================================

# ------------------------------------------------------------
# Base de datos MySQL
# Usar "db" como host cuando se ejecuta con docker-compose,
# "localhost" para desarrollo local sin Docker.
# ------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_USER=diego
DB_PASSWORD=diego18
DB_NAME=proyecto_ia

# Contraseña del usuario root de MySQL (solo usada por Docker)
MYSQL_ROOT_PASSWORD=root_pass

# ------------------------------------------------------------
# Autenticación JWT
# Genera una clave segura con: openssl rand -hex 32
# ------------------------------------------------------------
SECRET_KEY=cambia_esta_clave_secreta_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60
